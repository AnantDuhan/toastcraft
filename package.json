{
  "name": "toastcraft",
  "version": "0.1.2",
  "description": "Framework-agnostic, zero-dependency toast notifications with 15 built-in designs and deep configuration.",
  "keywords": [
    "toast",
    "notification",
    "snackbar",
    "alert",
    "ui",
    "vanilla",
    "angular",
    "react",
    "vue",
    "typescript",
    "toast notification",
    "toast notifications",
    "toast library",
    "notification library",
    "javascript toast",
    "typescript toast",
    "framework agnostic"
  ],
  "author": "Anant <aanantduhan@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/toastcraft.global.js",
  "jsdelivr": "./dist/toastcraft.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && node demo/build.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run demo && git add docs && git commit -m \"docs: update playground\" && git push"
  },
  "devDependencies": {
    "happy-dom": "^15.11.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnantDuhan/toastcraft.git"
  },
  "homepage": "https://toastcraft.netlify.app/",
  "bugs": {
    "url": "https://github.com/AnantDuhan/toastcraft/issues"
  }
}
