From c10c199a37828ce242510b2d1a826b772bf6d418 Mon Sep 17 00:00:00 2001
From: Anant Duhan <duhananant@gmail.com>
Date: Wed, 25 Nov 2026 04:21:50 +0000
Subject: [PATCH] feat(site): add toastcraft logo and favicons

- Add the toastcraft mark: three stacked notifications with a status dot
- Add favicon.ico (16/32/48), favicon.svg, apple-touch-icon.png and
  192/512 icons
- Show the mark beside the wordmark on the playground and the
  migration guide, with a faint edge so it stays visible in dark mode
---
 demo/migrate.html                       |   7 ++++++-
 demo/template.html                      |   7 ++++++-
 docs/apple-touch-icon.png               | Bin 0 -> 4223 bytes
 docs/favicon.ico                        | Bin 0 -> 2842 bytes
 docs/favicon.svg                        |   9 +++++++++
 docs/icon-192.png                       | Bin 0 -> 6672 bytes
 docs/icon-512.png                       | Bin 0 -> 22454 bytes
 docs/index.html                         |   7 ++++++-
 docs/migrate-from-ngx-toastr/index.html |   7 ++++++-
 9 files changed, 33 insertions(+), 4 deletions(-)
 create mode 100644 docs/apple-touch-icon.png
 create mode 100644 docs/favicon.ico
 create mode 100644 docs/favicon.svg
 create mode 100644 docs/icon-192.png
 create mode 100644 docs/icon-512.png

diff --git a/demo/migrate.html b/demo/migrate.html
index 5a1b123..e4a1349 100644
--- a/demo/migrate.html
+++ b/demo/migrate.html
@@ -4,6 +4,10 @@
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
 <title>Migrate from ngx-toastr to ngx-toastcraft</title>
+<link rel="icon" href="/favicon.ico" sizes="32x32">
+<link rel="icon" href="/favicon.svg" type="image/svg+xml">
+<link rel="apple-touch-icon" href="/apple-touch-icon.png">
+<meta name="theme-color" content="#161c30">
 <meta name="description" content="Switch an Angular app from ngx-toastr to ngx-toastcraft in a few minutes: package swap, provider, service calls, option mapping and the two behavior changes to check.">
 <link rel="canonical" href="https://toastcraft.netlify.app/migrate-from-ngx-toastr/">
 <meta property="og:type" content="article">
@@ -36,6 +40,7 @@ a{color:var(--ink);text-underline-offset:3px}
 a:hover{color:var(--pick)}
 .wrap{max-width:920px;margin:0 auto;padding:32px 24px 80px}
 .top{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;font-size:14px;margin-bottom:48px}
+.brand .mark{border-radius:22%;box-shadow:0 0 0 1px color-mix(in srgb,var(--ink) 14%,transparent);width:30px;height:30px;vertical-align:-7px;margin-right:9px}
 .brand{font-family:var(--display);font-weight:700;font-size:22px;letter-spacing:-.02em;text-decoration:none}
 .top nav{display:flex;gap:16px}
 h1{font-family:var(--display);font-weight:700;font-size:clamp(36px,6vw,60px);line-height:1;letter-spacing:-.03em;margin:0;max-width:16ch}
@@ -81,7 +86,7 @@ footer{margin-top:72px;padding-top:24px;border-top:1px solid var(--line);color:v
 <body>
 <div class="wrap">
   <div class="top">
-    <a class="brand" href="../#angular">toastcraft</a>
+    <a class="brand" href="../#angular"><img class="mark" src="../favicon.svg" alt="">toastcraft</a>
     <nav>
       <a href="../#angular">Playground</a>
       <a href="https://www.npmjs.com/package/ngx-toastcraft">npm</a>
diff --git a/demo/template.html b/demo/template.html
index bf036d6..57473ce 100644
--- a/demo/template.html
+++ b/demo/template.html
@@ -4,6 +4,10 @@
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
 <title>toastcraft playground</title>
+<link rel="icon" href="/favicon.ico" sizes="32x32">
+<link rel="icon" href="/favicon.svg" type="image/svg+xml">
+<link rel="apple-touch-icon" href="/apple-touch-icon.png">
+<meta name="theme-color" content="#161c30">
 <meta name="description" content="Toast notifications with 15 built-in designs for JavaScript and Angular. Pick a design, tune the options and copy the code.">
 <meta property="og:type" content="website">
 <meta property="og:site_name" content="toastcraft">
@@ -34,6 +38,7 @@ html{scroll-padding-top:env(safe-area-inset-top,0px)}
 body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 var(--body)}
 .wrap{max-width:1240px;margin:0 auto;padding:40px 24px 64px}
 header{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end;margin-bottom:36px}
+h1 .mark{box-shadow:0 0 0 1px color-mix(in srgb,var(--ink) 14%,transparent);width:.82em;height:.82em;margin-right:.16em;vertical-align:-.06em;border-radius:22%}
 h1{font-family:var(--display);font-weight:700;font-size:clamp(44px,7vw,84px);line-height:.95;letter-spacing:-.035em;margin:0}
 .lede{max-width:52ch;color:var(--muted);margin:14px 0 0;font-size:17px}
 .side{display:flex;flex-direction:column;align-items:flex-end;gap:12px}
@@ -103,7 +108,7 @@ pre .k{color:#8fa2ff}pre .s{color:#9fe0b4}pre .c{color:#6c7489}
 <div class="wrap">
   <header>
     <div>
-      <h1>toastcraft</h1>
+      <h1><img class="mark" src="favicon.svg" alt="">toastcraft</h1>
       <p class="lede">Toast notifications with 15 built-in designs, for plain JavaScript and Angular. Pick a design, tune the options, and copy the code for your framework.</p>
     </div>
     <div class="side">
